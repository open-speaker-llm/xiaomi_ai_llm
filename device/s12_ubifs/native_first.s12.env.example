# S12 1.74.18 / system1, first-turn-only reference configuration.
# Create a separate private /data/native_first.env (chmod 600); never commit keys.
BACKEND=deepseek
LLM_PIPELINE=native
DEEPSEEK_API_KEY=
LLM_WEB_SEARCH=auto
LLM_WEB_PLAN_TIMEOUT=10
LLM_WEB_TIMEOUT=12
LLM_WEB_TOTAL_BUDGET=28
LLM_WEB_FALLBACK=fail
LLM_WEB_SPECULATIVE=0
TTS_ENGINE=device
DEVICE_TTS_BIN=/data/ettsc
DEVICE_TTS_VOICE=zh-CN-XiaoxiaoNeural
# S12: user heard a short answer and the search filler/answer with cues disabled.
DEVICE_TTS_STREAM=1
DEVICE_TTS_STREAM_COMMIT=0
DEVICE_TTS_GAIN=1.0
DIRAC_APLAY=/data/s12_dirac_aplay.sh
S12_FRACTIONAL_SLEEP=1
LLM_ROUTE_BEEP=0
LLM_END_BEEP=0
TTS_FALLBACK_NATIVE=1
AUDIO_CAPTURE_SETUP=0
NATIVE_RESULT_SOURCE=aivs_lab_instruction
FOLLOWUP_ENABLED=0
SYSTEM1_FOLLOWUP_ENABLED=0
FOLLOWUP_ASR_ENGINE=none
AIVS_GUARD_ENABLED=0
AIVS_EARLY_GUARD_ENABLED=0
LED_FEEDBACK_ENABLED=1
LED_RGB=/sys/devices/i2c-3/3-003c/led_rgb
SUPPRESS_NATIVE_THINK_LED=0
WAKE_ON_THINK_SYSTEM1=1
